{
  "name": "nest-template",
  "version": "0.0.1",
  "description": "Reusable NestJS service template - architecture, tooling and one worked example, no business logic.",
  "author": "sgranadaag",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check:standards": "node scripts/check-standards.mjs",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:cov": "npm test -- --coverage",
    "test:e2e": "npm test -- --config ./test/jest-e2e.json --runInBand",
    "migration:postgres:run": "typeorm-ts-node-commonjs migration:run -d src/config/postgres.datasource.ts",
    "migration:postgres:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/postgres.datasource.ts",
    "migration:mongo:run": "typeorm-ts-node-commonjs migration:run -d src/config/mongo.datasource.ts",
    "migration:mongo:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/mongo.datasource.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.7",
    "mongodb": "^7.7.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@middlewares/(.*)$": "<rootDir>/middlewares/$1",
      "^@utils/(.*)$": "<rootDir>/utils/$1",
      "^@decorators/(.*)$": "<rootDir>/decorators/$1",
      "^@interfaces/(.*)$": "<rootDir>/interfaces/$1",
      "^@tests/(.*)$": "<rootDir>/tests/$1",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@constants/(.*)$": "<rootDir>/constants/$1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@rspack/core": "^2.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "webpack-node-externals": "^3.0.0"
  }
}
